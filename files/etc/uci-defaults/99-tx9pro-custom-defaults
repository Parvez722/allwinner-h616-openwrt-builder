#!/bin/sh

# 1. NETWORK INTERFACE CONFIGURATION
# Configure br-lan bridge containing built-in eth0
uci -q delete network.@device[0]
uci set network.br_lan=device
uci set network.br_lan.name='br-lan'
uci set network.br_lan.type='bridge'
uci add_list network.br_lan.ports='eth0'

# LAN interface on br-lan (192.168.15.1)
uci set network.lan=interface
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.15.1'
uci set network.lan.netmask='255.255.255.0'

# Default USB eth will use as WAN (eth1)
uci set network.wan=interface
uci set network.wan.device='eth1'
uci set network.wan.proto='dhcp'
uci set network.wan.peerdns='1'
uci -q delete network.wan.dns
uci add_list network.wan.dns='8.8.8.8'
uci add_list network.wan.dns='1.1.1.1'

# USB Tethering fallback interface (usb0, rndis0, ncm0)
uci set network.wan_usb=interface
uci set network.wan_usb.device='usb0'
uci set network.wan_usb.proto='dhcp'
uci set network.wan_usb.peerdns='1'
uci -q delete network.wan_usb.dns
uci add_list network.wan_usb.dns='8.8.8.8'
uci add_list network.wan_usb.dns='1.1.1.1'
uci commit network

# Adjust DHCP pool for 192.168.15.x subnet with explicit gateway and public DNS options
uci -q delete dhcp.lan.ignore
uci set dhcp.lan.interface='lan'
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.dhcp_option
uci add_list dhcp.lan.dhcp_option='3,192.168.15.1'
uci add_list dhcp.lan.dhcp_option='6,192.168.15.1,8.8.8.8,1.1.1.1'
uci set dhcp.@dnsmasq[0].rebind_protection='0'
uci commit dhcp

# 2. FIREWALL & NAT CONFIGURATION
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'

# Add wan_usb to WAN firewall zone and ensure MASQUERADE is on
uci -q delete firewall.@zone[1].network
uci add_list firewall.@zone[1].network='wan'
uci add_list firewall.@zone[1].network='wan6'
uci add_list firewall.@zone[1].network='wan_usb'
uci set firewall.@zone[1].masq='1'
uci set firewall.@zone[1].mtu_fix='1'
uci set firewall.@zone[1].input='ACCEPT'
uci set firewall.@zone[1].output='ACCEPT'
uci set firewall.@zone[1].forward='ACCEPT'

# Open LAN zone
uci set firewall.@zone[0].input='ACCEPT'
uci set firewall.@zone[0].output='ACCEPT'
uci set firewall.@zone[0].forward='ACCEPT'

# Ensure LAN-to-WAN forwarding rule exists
uci -q delete firewall.lan_to_wan
uci set firewall.lan_to_wan=forwarding
uci set firewall.lan_to_wan.src='lan'
uci set firewall.lan_to_wan.dest='wan'

# Open ports on WAN (SSH & LuCI)
uci -q delete firewall.Allow_LuCI_WAN
uci set firewall.Allow_LuCI_WAN=rule
uci set firewall.Allow_LuCI_WAN.name='Allow-LuCI-WAN'
uci set firewall.Allow_LuCI_WAN.src='wan'
uci set firewall.Allow_LuCI_WAN.proto='tcp'
uci set firewall.Allow_LuCI_WAN.dest_port='80 443'
uci set firewall.Allow_LuCI_WAN.target='ACCEPT'

uci -q delete firewall.Allow_SSH_WAN
uci set firewall.Allow_SSH_WAN=rule
uci set firewall.Allow_SSH_WAN.name='Allow-SSH-WAN'
uci set firewall.Allow_SSH_WAN.src='wan'
uci set firewall.Allow_SSH_WAN.proto='tcp'
uci set firewall.Allow_SSH_WAN.dest_port='22'
uci set firewall.Allow_SSH_WAN.target='ACCEPT'
uci commit firewall

# 3. WEB UI & SSH CONFIGURATION
uci set uhttpd.main.listen_http='0.0.0.0:80'
uci -q add_list uhttpd.main.listen_http='[::]:80'
uci -q set uhttpd.main.listen_https='0.0.0.0:443'
uci -q add_list uhttpd.main.listen_https='[::]:443'
uci commit uhttpd

uci -q delete dropbear.@dropbear[0].Interface
uci set dropbear.@dropbear[0].RootPasswordAuth='on' 2>/dev/null || true
uci set dropbear.@dropbear[0].PasswordAuth='on' 2>/dev/null || true
uci set dropbear.@dropbear[0].GatewayPorts='on' 2>/dev/null || true
uci commit dropbear

# 4. ARGON THEME PRE-INSTALLED & WHITE MODE
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci

uci -q set argon.@global[0].mode='light'
uci -q set argon.@global[0].dark='false'
uci -q commit argon 2>/dev/null || true

# 5. WI-FI PRECONFIG (5GHz, Channel 161, Bangladesh Region, HT40 Mode, 20 dBm Power)
if command -v wifi >/dev/null 2>&1; then
    wifi config
    uci set wireless.@wifi-device[0].disabled='0'
    uci set wireless.@wifi-device[0].country='BD'
    uci set wireless.@wifi-device[0].channel='161'
    uci set wireless.@wifi-device[0].band='5g'
    uci set wireless.@wifi-device[0].htmode='HT40'
    uci set wireless.@wifi-device[0].txpower='20'
    uci set wireless.@wifi-device[0].cell_density='0'

    uci set wireless.@wifi-iface[0].disabled='0'
    uci set wireless.@wifi-iface[0].network='lan'
    uci set wireless.@wifi-iface[0].mode='ap'
    uci set wireless.@wifi-iface[0].ssid='TX9Pro-5G'
    uci set wireless.@wifi-iface[0].encryption='none'
    uci commit wireless
    iw reg set BD 2>/dev/null || true
fi

# 6. SYSTEM & SYSCTL ROUTING / PROXY ARP FIXES
mkdir -p /etc/sysctl.d
cat << 'EOF' > /etc/sysctl.d/99-custom.conf
net.ipv4.ip_forward=1
net.ipv4.conf.all.forwarding=1
net.ipv4.conf.all.proxy_arp=1
net.ipv4.conf.default.proxy_arp=1
net.ipv6.conf.all.forwarding=1
EOF
sysctl -p /etc/sysctl.d/99-custom.conf 2>/dev/null || true

# 7. KWRT & OPENWRT.AI OPKG REPOSITORY SETUP
cat << 'EOF' > /etc/opkg/distfeeds.conf
src/gz kwrt_base https://dl.openwrt.ai/packages-25.12/aarch64_cortex-a53/base
src/gz kwrt_kiddin9 https://dl.openwrt.ai/packages-25.12/aarch64_cortex-a53/kiddin9
src/gz kwrt_luci https://dl.openwrt.ai/packages-25.12/aarch64_cortex-a53/luci
src/gz kwrt_packages https://dl.openwrt.ai/packages-25.12/aarch64_cortex-a53/packages
src/gz kwrt_routing https://dl.openwrt.ai/packages-25.12/aarch64_cortex-a53/routing
src/gz kwrt_video https://dl.openwrt.ai/packages-25.12/aarch64_cortex-a53/video
EOF

cat << 'EOF' > /etc/opkg/customfeeds.conf
# Kwrt (kiddin9) Community Packages & Plugins from https://dl.openwrt.ai/
src/gz kwrt_kiddin9 https://dl.openwrt.ai/packages-25.12/aarch64_cortex-a53/kiddin9
EOF

sed -i 's/option check_signature/# option check_signature/g' /etc/opkg.conf
grep -q 'check_signature 0' /etc/opkg.conf || echo 'option check_signature 0' >> /etc/opkg.conf
grep -q 'force_space 1' /etc/opkg.conf || echo 'option force_space 1' >> /etc/opkg.conf

# 8. STORAGE AUTOMOUNT PRE-CONFIGURATION
uci set fstab.@global[0].anon_swap='0'
uci set fstab.@global[0].anon_mount='1'
uci set fstab.@global[0].auto_swap='0'
uci set fstab.@global[0].auto_mount='1'
uci set fstab.@global[0].check_fs='1'
uci commit fstab

exit 0
